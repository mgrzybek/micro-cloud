{% if ip_address | length > 0 %}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: grafana-endpoint
  namespace: observability
spec:
  secretName: grafana-endpoint
  duration: 2160h # 90d
  renewBefore: 360h # 15d
  subject:
    organizations:
      - {{pki_org}}
  commonName: grafana.{{ts_suffix}}
  isCA: false
  privateKey:
    algorithm: RSA
    encoding: PKCS1
    size: 2048
  usages:
    - server auth
  dnsNames:
    - grafana.{{ts_suffix}}
  ipAddresses:
    - {{ip_address}}
  issuerRef:
    name: openbao-internal-ca
    kind: ClusterIssuer
{% endif %}
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: grafana
  namespace: observability
spec:
  gatewayClassName: cilium
  infrastructure:
    annotations:
      tailscale.com/expose: "true"
      tailscale.com/hostname: grafana
  listeners:
{% if ip_address | length > 0 %}
  - protocol: HTTPS
    port: 443
    name: grafana-https
    allowedRoutes:
      namespaces:
        from: Same
    hostname: grafana.{{ts_suffix}}
    tls:
      certificateRefs:
      - kind: Secret
        name: grafana-endpoint
      mode: Terminate
{% else %}
  - protocol: HTTP
    port: 80
    name: grafana-http
    allowedRoutes:
      namespaces:
        from: Same
    hostname: grafana.{{ts_suffix}}
{% endif %}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: http-grafana
  namespace: observability
spec:
  parentRefs:
  - group: gateway.networking.k8s.io
    kind: Gateway
    name: grafana
    namespace: observability
  rules:
  - backendRefs:
    - group: ""
      kind: Service
      name: grafana
      port: 80
      weight: 1
    matches:
    - path:
        type: PathPrefix
        value: /
